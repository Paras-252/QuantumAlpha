# ==============================================================================
# QUANTUM ALPHA PRO TRADING TERMINAL — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' and fill in your values.
# IMPORTANT: Never commit your actual '.env' file with real secrets to GitHub!

# ------------------------------------------------------------------------------
# 1. ZERODHA KITE CONNECT SECRETS (Required for Live Tick-by-Tick Feed)
# ------------------------------------------------------------------------------
# 1. Sign up / Log in to: https://developers.kite.trade/
# 2. Create an App under "My Apps" to obtain your API Key and API Secret.
# 3. Complete the login flow once per day to obtain your daily Access Token.
VITE_KITE_API_KEY=your_api_key_here
VITE_KITE_ACCESS_TOKEN=your_daily_access_token_here
KITE_API_SECRET=your_api_secret_here

# ------------------------------------------------------------------------------
# 2. CONNECTION ROUTING MODE
# ------------------------------------------------------------------------------
# 'relay'  - (Recommended) Routes WebSocket through GoDaddy server.js using
#            GoDaddy's permanent whitelisted Static IP (prevents Jio dynamic IP blocks).
# 'direct' - Connects your browser directly to wss://ws.kite.trade (use only if your
#            current personal IP is whitelisted in Zerodha).
VITE_KITE_CONNECTION_MODE=relay

# (Optional) If hosting on GoDaddy with a custom domain or subdomain:
# e.g., VITE_KITE_RELAY_HOST=terminal.yourdomain.com
VITE_KITE_RELAY_HOST=

# ------------------------------------------------------------------------------
# 3. GODADDY / NODE.JS PRODUCTION SERVER (server.js)
# ------------------------------------------------------------------------------
PORT=3000

# ------------------------------------------------------------------------------
# 4. TREDYE CLOUD QUANTITATIVE ANALYTICS API (Default CDN)
# ------------------------------------------------------------------------------
VITE_TREDYE_DATA_URL=https://data.tredye.com

